{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/html/SGPI.html"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/html/SGPI.html"
    },
    {
      "source": "/SGPI",
      "destination": "/frontend/html/SGPI.html"
    },
    {
      "source": "/SGPI.html",
      "destination": "/frontend/html/SGPI.html"
    },
    {
      "source": "/catalogo",
      "destination": "/frontend/html/catalogo.html"
    },
    {
      "source": "/catalogo.html",
      "destination": "/frontend/html/catalogo.html"
    },
    {
      "source": "/html/(.*)",
      "destination": "/frontend/html/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/frontend/js/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://sgpi-backend-api.onrender.com/$1"
    },
    {
      "source": "/propuestas",
      "destination": "https://sgpi-backend-api.onrender.com/propuestas"
    },
    {
      "source": "/catalogos",
      "destination": "https://sgpi-backend-api.onrender.com/catalogos"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://sgpi-backend-api.onrender.com/auth/$1"
    },
    {
      "source": "/propuestas/(.*)",
      "destination": "https://sgpi-backend-api.onrender.com/propuestas/$1"
    },
    {
      "source": "/ia/(.*)",
      "destination": "https://sgpi-backend-api.onrender.com/ia/$1"
    },
    {
      "source": "/notificaciones/(.*)",
      "destination": "https://sgpi-backend-api.onrender.com/notificaciones/$1"
    },
    {
      "source": "/modalidades/(.*)",
      "destination": "https://sgpi-backend-api.onrender.com/modalidades/$1"
    },
    {
      "source": "/escuelas/(.*)",
      "destination": "https://sgpi-backend-api.onrender.com/escuelas/$1"
    },
    {
      "source": "/lineas_de_investigacion/(.*)",
      "destination": "https://sgpi-backend-api.onrender.com/lineas_de_investigacion/$1"
    },
    {
      "source": "/convocatorias/(.*)",
      "destination": "https://sgpi-backend-api.onrender.com/convocatorias/$1"
    },
    {
      "source": "/catalogos/(.*)",
      "destination": "https://sgpi-backend-api.onrender.com/catalogos/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://sgpi-backend-api.onrender.com/admin/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
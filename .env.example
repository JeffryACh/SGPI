DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>

# Alta de investigadores en el directorio institucional (POST /auth/usuarios).
# Dominios de correo autorizados para dar de alta una cuenta nueva (separados por coma).
# Producción: solo el dominio institucional. Demostración: se pueden añadir otros.
DOMINIOS_CORREO_PERMITIDOS=tec.ac.cr
# Contraseña inicial fija de las cuentas nuevas (modo demostración). Vacío = contraseña aleatoria
# enviada por correo. En producción déjalo vacío.
PASSWORD_DEMO=
# Envío del correo con las credenciales iniciales. Si SMTP_HOST queda vacío, la contraseña se
# devuelve en la respuesta de la API para poder completar el flujo en el modo prototipo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@tec.ac.cr
SMTP_TLS=1
